# Copy this file to .env locally. On Vercel, add these in Project Settings → Environment Variables.

# Required: POOLED connection string for normal app queries.
# The app also accepts POSTGRES_URL, POSTGRES_PRISMA_URL, NEON_DATABASE_URL,
# or SUPABASE_DB_URL. Add ?sslmode=require when TLS is required.
DATABASE_URL=

# Recommended for Neon/Vercel: DIRECT (non-pooled) connection string.
# Used only for schema creation and the bundled data restore.
# Neon integration names this DATABASE_URL_UNPOOLED; legacy Vercel Postgres
# names it POSTGRES_URL_NON_POOLING. The app accepts either.
DATABASE_URL_UNPOOLED=

# Optional secret for calling /api/cron/analysis from an external scheduler.
CRON_SECRET=
